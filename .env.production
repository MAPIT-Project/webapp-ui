# MAP-IT production environment contract
# Replace every placeholder before deployment. Never commit real secrets.

# REQUIRED | server-only | runtime and Drizzle tooling
PRIVATE_DATABASE_URL="postgresql://mapit:replace-me@127.0.0.1:54322/postgres"
DATABASE_URL="postgresql://mapit:replace-me@127.0.0.1:54322/postgres"

# REQUIRED | public | build + browser/runtime
PUBLIC_SUPABASE_URL="https://new.mapit.work/supabase"
PUBLIC_SUPABASE_ANON_KEY="replace-with-production-anon-key"

# REQUIRED for collaboration administration | server-only | runtime
SUPABASE_SERVICE_ROLE_KEY="replace-with-production-service-role-key"

# REQUIRED | server-only | runtime
BACKEND_URL="http://127.0.0.1:18000"
JWT_SECRET_KEY="replace-with-the-backend-shared-secret-at-least-32-characters"

# REQUIRED by adapter-node behind nginx | server-only | runtime
HOST="127.0.0.1"
PORT="3000"
ORIGIN="https://new.mapit.work"

# OPTIONAL | server-only | runtime. Omit for host-only cookies.
COOKIE_DOMAIN="new.mapit.work"

# OPTIONAL legacy test-route aliases | server-only | runtime
VITE_SUPABASE_URL="https://new.mapit.work/supabase"
VITE_SUPABASE_ANON_KEY="replace-with-production-anon-key"

# OPTIONAL | public | build + browser/runtime
PUBLIC_APP_NAME="MapIt AI Expert"
PUBLIC_APP_URL="https://new.mapit.work"
PUBLIC_APP_ENV="production"
PUBLIC_ENABLE_DEBUG_TOOLS="false"
PUBLIC_ENABLE_ANALYTICS="true"
PUBLIC_API_TIMEOUT_MS="30000"
PUBLIC_MAX_UPLOAD_SIZE_MB="10"
