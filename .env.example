# =============================================================================
# MapIt WebApp - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL database connection string
PRIVATE_DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# =============================================================================
# Supabase Configuration
# =============================================================================
# Supabase project URL (public - used in browser)
VITE_SUPABASE_URL="https://your-project.supabase.co"
# Supabase anonymous/public key (safe to expose)
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Supabase service role key (server-side only - keep secret!)
PUBLIC_SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# Supabase URLs (aliases)
PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_URL="http://localhost:54321"  # Use localhost for server-side requests

# Supabase service role key for admin operations
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# =============================================================================
# Backend AI API Configuration
# =============================================================================
# Backend API URL for AI/chat services
BACKEND_URL="http://localhost:8000"

# JWT Secret for backend authentication (must match backend's JWT_SECRET_KEY)
JWT_SECRET_KEY="generate-a-secure-random-secret-here"

# =============================================================================
# Third-party API Keys
# =============================================================================
# Google API Key (for embeddings, search, etc.)
GOOGLE_API_KEY="your-google-api-key"

# Mapbox API Key (for maps/visualization)
MAPBOX_API_KEY="your-mapbox-api-key"

# =============================================================================
# Application Settings
# =============================================================================
PUBLIC_APP_NAME=MapIt AI Expert
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_APP_ENV=development

# =============================================================================
# Feature Flags
# =============================================================================
PUBLIC_ENABLE_DEBUG_TOOLS=true
PUBLIC_ENABLE_ANALYTICS=false

# =============================================================================
# Performance Settings
# =============================================================================
PUBLIC_API_TIMEOUT_MS=30000
PUBLIC_MAX_UPLOAD_SIZE_MB=10

# =============================================================================
# Optional: Development Settings
# =============================================================================
# Set to true to enable detailed logging
DEBUG=false

# =============================================================================
# Generating a JWT Secret
# =============================================================================
# To generate a secure JWT secret, run:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# IMPORTANT: Use the SAME secret in both this .env file AND the backend .env
