# MAP-IT frontend environment contract
# Copy to .env for local development. Never commit real secrets.
# Labels: required/optional | public/server | build/runtime/db

# REQUIRED | server-only | runtime
# Runtime connection used by src/lib/server/db/index.ts.
PRIVATE_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# REQUIRED for npm run db:* | server-only | db tooling
# Keep equal to PRIVATE_DATABASE_URL unless the migration user is intentionally different.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# REQUIRED | public | build + browser/runtime
# Local Supabase API (not Studio; Studio is on 54323).
PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
PUBLIC_SUPABASE_ANON_KEY="replace-with-anon-key-from-supabase-start"

# REQUIRED for collaboration invite/member administration | server-only | runtime
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key-from-supabase-start"

# REQUIRED | server-only | runtime
BACKEND_URL="http://127.0.0.1:18000"

# REQUIRED | server-only | runtime
# Must be at least 32 characters and identical to JWT_SECRET_KEY in MAP-IT_SA.
JWT_SECRET_KEY="replace-with-a-shared-random-secret-at-least-32-characters"

# OPTIONAL legacy aliases | server-only | runtime
# Only src/routes/api/test_rls reads these. Main app code uses PUBLIC_SUPABASE_*.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="replace-with-anon-key-from-supabase-start"

# OPTIONAL | public | build + browser/runtime (defaults shown)
PUBLIC_APP_NAME="MapIt AI Expert"
PUBLIC_APP_URL="http://localhost:5173"
PUBLIC_APP_ENV="development"
PUBLIC_ENABLE_DEBUG_TOOLS="true"
PUBLIC_ENABLE_ANALYTICS="false"
PUBLIC_API_TIMEOUT_MS="30000"
PUBLIC_MAX_UPLOAD_SIZE_MB="10"

# OPTIONAL | server-only | runtime
# Leave unset locally for a host-only localhost cookie. Production may set one exact domain.
# COOKIE_DOMAIN="new.mapit.work"
