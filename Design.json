{
	"designSystem": {
		"name": "Mapit UI",
		"version": "1.0.0",
		"description": "A modern, dark-themed design system for a collaborative application.",
		"style": {
			"theme": "dark",
			"overallAppearance": "Clean, spacious, and modern with a focus on readability and clear information hierarchy."
		},
		"palette": {
			"primary": {
				"background": "#121212",
				"surface": "#1E1E1E",
				"onSurface": "#FFFFFF"
			},
			"secondary": {
				"main": "#3A3A3A",
				"light": "#4F4F4F",
				"dark": "#2C2C2C",
				"contrastText": "#FFFFFF"
			},
			"accent": {
				"main": "#2196F3",
				"light": "#42A5F5",
				"contrastText": "#FFFFFF"
			},
			"text": {
				"primary": "#E0E0E0",
				"secondary": "#B0B0B0",
				"disabled": "#757575",
				"link": "#42A5F5"
			},
			"status": {
				"info": "#2196F3",
				"success": "#4CAF50",
				"warning": "#FFC107",
				"error": "#F44336"
			}
		},
		"typography": {
			"fontFamily": "Inter, sans-serif",
			"headings": {
				"h1": {
					"fontSize": "2rem",
					"fontWeight": "700"
				},
				"h2": {
					"fontSize": "1.5rem",
					"fontWeight": "600"
				},
				"h3": {
					"fontSize": "1.25rem",
					"fontWeight": "600"
				}
			},
			"body": {
				"fontSize": "1rem",
				"fontWeight": "400"
			},
			"caption": {
				"fontSize": "0.875rem",
				"fontWeight": "400"
			}
		},
		"layout": {
			"grid": {
				"columns": 12,
				"gutter": "16px"
			},
			"spacing": {
				"baseUnit": "8px",
				"small": "4px",
				"medium": "16px",
				"large": "24px",
				"xlarge": "32px"
			},
			"structure": {
				"main": {
					"display": "grid",
					"gridTemplateColumns": "260px 1fr",
					"height": "100vh"
				},
				"sidebar": {
					"backgroundColor": "palette.secondary.dark",
					"padding": "layout.spacing.medium"
				},
				"content": {
					"padding": "layout.spacing.large",
					"display": "flex",
					"flexDirection": "column"
				}
			}
		},
		"components": {
			"button": {
				"base": {
					"borderRadius": "8px",
					"padding": "10px 16px",
					"fontWeight": "500",
					"transition": "background-color 0.3s ease"
				},
				"variants": {
					"primary": {
						"backgroundColor": "palette.accent.main",
						"color": "palette.accent.contrastText",
						"hover": {
							"backgroundColor": "palette.accent.light"
						}
					},
					"secondary": {
						"backgroundColor": "palette.secondary.main",
						"color": "palette.secondary.contrastText",
						"hover": {
							"backgroundColor": "palette.secondary.light"
						}
					}
				}
			},
			"input": {
				"backgroundColor": "palette.secondary.dark",
				"borderRadius": "8px",
				"border": "1px solid #4F4F4F",
				"padding": "12px",
				"color": "palette.text.primary",
				"placeholderColor": "palette.text.secondary",
				"focus": {
					"borderColor": "palette.accent.main"
				}
			},
			"card": {
				"backgroundColor": "palette.primary.surface",
				"borderRadius": "12px",
				"padding": "layout.spacing.medium",
				"boxShadow": "0 4px 6px rgba(0, 0, 0, 0.1)"
			},
			"listItem": {
				"padding": "12px 16px",
				"borderRadius": "8px",
				"hover": {
					"backgroundColor": "palette.secondary.light"
				},
				"active": {
					"backgroundColor": "palette.secondary.main"
				}
			},
			"badge": {
				"borderRadius": "12px",
				"padding": "4px 10px",
				"fontSize": "0.75rem",
				"fontWeight": "500",
				"variants": {
					"personal": {
						"backgroundColor": "rgba(33, 150, 243, 0.2)",
						"color": "#64B5F6"
					},
					"team": {
						"backgroundColor": "rgba(33, 150, 243, 0.2)",
						"color": "#64B5F6"
					}
				}
			},
			"icon": {
				"size": "24px",
				"color": "palette.text.secondary"
			},
			"divider": {
				"color": "palette.secondary.main",
				"height": "1px"
			}
		}
	}
}
