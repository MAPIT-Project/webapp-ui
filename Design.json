{
	"designSystem": {
		"name": "Mapit UI",
		"version": "2.0.0",
		"description": "A modern, dark-themed design system with context-aware coloring (Personal vs. Collaboration).",
		"style": {
			"theme": "dark",
			"overallAppearance": "Glassmorphism-inspired, clean dark mode with gradient backgrounds and backdrop blurs."
		},
		"palette": {
			"base": {
				"background": {
					"primary": "#1A1A1A",
					"secondary": "#161616",
					"tertiary": "#141414",
					"gradient": "linear-gradient(to bottom, #1A1A1A, #161616)"
				},
				"surface": {
					"primary": "#1E1E1E",
					"secondary": "#2A2A2A",
					"card": "rgba(30, 30, 30, 0.6)",
					"glass": "rgba(42, 42, 42, 0.3)"
				},
				"border": {
					"primary": "rgba(64, 64, 64, 0.2)",
					"secondary": "rgba(79, 79, 79, 0.5)",
					"highlight": "rgba(255, 255, 255, 0.1)"
				}
			},
			"context": {
				"personal": {
					"primary": "#3B82F6",
					"secondary": "#2563EB",
					"surface": "rgba(59, 130, 246, 0.1)",
					"border": "rgba(59, 130, 246, 0.3)",
					"text": "#93C5FD"
				},
				"collaboration": {
					"primary": "#A855F7",
					"secondary": "#9333EA",
					"surface": "rgba(168, 85, 247, 0.1)",
					"border": "rgba(168, 85, 247, 0.3)",
					"text": "#D8B4FE"
				}
			},
			"text": {
				"primary": "#F5F5F5",
				"secondary": "#B0B0B0",
				"tertiary": "#6B7280",
				"muted": "#9CA3AF",
				"inverse": "#121212"
			},
			"status": {
				"error": {
					"main": "#F44336",
					"background": "rgba(244, 67, 54, 0.2)",
					"border": "rgba(244, 67, 54, 0.3)"
				},
				"success": {
					"main": "#4CAF50"
				},
				"warning": {
					"main": "#FFC107"
				},
				"info": {
					"main": "#2196F3"
				}
			}
		},
		"typography": {
			"fontFamily": "Inter, sans-serif",
			"sizes": {
				"xs": "0.75rem",
				"sm": "0.875rem",
				"base": "1rem",
				"lg": "1.125rem",
				"xl": "1.25rem",
				"2xl": "1.5rem",
				"3xl": "1.875rem",
				"4xl": "2.25rem"
			},
			"weights": {
				"regular": "400",
				"medium": "500",
				"semibold": "600",
				"bold": "700"
			}
		},
		"layout": {
			"sidebar": {
				"width": {
					"expanded": "250px",
					"collapsed": "65px",
					"chat": "256px"
				},
				"background": "linear-gradient(to bottom, #1A1A1A, #161616)",
				"border": "1px solid rgba(96, 96, 96, 0.2)"
			},
			"spacing": {
				"xs": "4px",
				"sm": "8px",
				"md": "12px",
				"lg": "16px",
				"xl": "20px",
				"2xl": "24px"
			}
		},
		"components": {
			"card": {
				"borderRadius": "12px",
				"background": "#1E1E1E",
				"border": "1px solid #4F4F4F",
				"shadow": "0 4px 6px rgba(0, 0, 0, 0.1)"
			},
			"button": {
				"borderRadius": "8px",
				"transition": "all 0.2s ease",
				"variants": {
					"icon": {
						"hover": "rgba(255, 255, 255, 0.1)"
					}
				}
			},
			"input": {
				"background": "rgba(31, 41, 55, 0.5)",
				"border": "1px solid rgba(59, 130, 246, 0.5)",
				"borderRadius": "8px",
				"padding": "0.5rem"
			},
			"badge": {
				"borderRadius": "9999px",
				"padding": "0.125rem 0.5rem",
				"fontSize": "0.75rem"
			},
			"modal": {
				"background": "#1E1E1E",
				"border": "1px solid #4F4F4F",
				"borderRadius": "12px",
				"shadow": "0 25px 50px -12px rgba(0, 0, 0, 0.25)"
			}
		}
	}
}