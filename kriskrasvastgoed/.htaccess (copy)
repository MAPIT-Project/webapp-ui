####FORCEHTTPS_HEADER####
RewriteEngine on
#RULE:kriskrasvastgoed.nl
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(www\.)?kriskrasvastgoed.nl$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [last,R=301]

# Directe toegang tot form pagina's (moet bovenaan staan)
RewriteRule ^form/?$ form.php [L]
RewriteRule ^form_test/?$ form_test.php [L]

RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [NC,L,R]

RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^ %{REQUEST_URI}.html [NC,L]

# Handle PHP files in subdirectories
RewriteCond %{REQUEST_URI} ^/php/([^/]+)$
RewriteCond %{DOCUMENT_ROOT}/php/%1.php -f
RewriteRule ^php/([^/]+)$ php/$1.php [NC,END]

